# Cloudflare Pages response headers. The site runs no JS of its own; script-src 'self'
# covers Cloudflare's injected email-decode script, and style-src needs 'unsafe-inline'
# for Shiki and Astro's inline style attributes.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  ! Access-Control-Allow-Origin
