{
  "name": "personal-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && . \"$HOME/.env\" && CLOUDFLARE_API_TOKEN=\"$CLOUDFLARE_API_TOKEN_PERSONAL\" CLOUDFLARE_ACCOUNT_ID=\"$CLOUDFLARE_ACCOUNT_ID_PERSONAL\" wrangler pages deploy dist --project-name personal-web --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260811.1": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
