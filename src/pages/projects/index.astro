---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/site";
---

<Base
	title="Projects"
	description="Robotics, machine learning, IoT and embedded systems projects by Gareth A. Harrison."
>
	<section>
		<div class="wrap">
			<h2 class="section-title">Projects</h2>
			<div class="grid">
				{
					projects.map((project) => (
						<article class="card">
							<h3>{project.title}</h3>
							{(project.org || project.period) && (
								<p class="meta">{[project.org, project.period].filter(Boolean).join(" · ")}</p>
							)}
							<ul class="tags">
								{project.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
							<p>{project.blurb}</p>
							<ul>
								{project.points.map((point) => (
									<li>{point}</li>
								))}
							</ul>
							{project.href && (
								<p class="card-link">
									<a href={project.href} rel="noopener">
										{project.hrefLabel ?? "Repository"} →
									</a>
								</p>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>
</Base>
