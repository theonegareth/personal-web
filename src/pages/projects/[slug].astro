---
import { Image, getImage } from "astro:assets";
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site, projects, projectSlug, type Project } from "../../data/site";

export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const posts = await Promise.all(
	(project.posts ?? []).map(async (id) => {
		const post = await getEntry("blog", id);
		if (!post || post.data.draft) throw new Error(`${project.title}: no published post "${id}"`);
		return post;
	}),
);
const fullSize = async (src: ImageMetadata) => (await getImage({ src, width: Math.min(src.width, 2400), format: "webp" })).src;
const imageFull = project.image && (await fullSize(project.image));
const figuresFull = await Promise.all((project.figures ?? []).map((figure) => fullSize(figure.image)));
const url = new URL(Astro.url.pathname, site.url).href;
const jsonLd = {
	"@type": "CreativeWork",
	name: project.title,
	description: project.blurb,
	url,
	author: { "@id": `${site.url}/#person` },
	keywords: project.tags.join(", "),
	...(project.period && { temporalCoverage: project.period }),
	...(project.org && { sourceOrganization: { "@type": "Organization", name: project.org } }),
	...(project.href && { sameAs: project.href }),
};
---

<Base title={project.title} description={project.blurb} ogType="article" jsonLd={jsonLd}>
	<section>
		<div class="wrap">
			<article class="prose">
				<p class="meta">{[project.org, project.period].filter(Boolean).join(" · ")}</p>
				<h1>{project.title}</h1>
				<p>By <a href="/">{site.name}</a></p>
				{
					project.image && (
						<figure class="project-figure">
							<a href={imageFull} class="figure-link">
								<Image src={project.image} alt={project.imageAlt ?? project.title} widths={[720, 1080]} sizes="(min-width: 48rem) 62ch, 100vw" loading="eager" />
							</a>
						</figure>
					)
				}
				<p>{project.blurb}</p>
				<h2>What I did</h2>
				<ul>
					{project.points.map((point) => <li>{point}</li>)}
				</ul>
				{
					project.figures?.map((figure, i) => (
						<figure class="project-figure">
							<a href={figuresFull[i]} class="figure-link">
								<Image src={figure.image} alt={figure.alt} widths={[720, 1080]} sizes="(min-width: 48rem) 62ch, 100vw" />
							</a>
							<figcaption>{figure.caption}</figcaption>
						</figure>
					))
				}
				{
					posts.length > 0 && (
						<>
							<h2>{posts.length > 1 ? "Posts" : "Post"}</h2>
							<ul>
								{posts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</li>
								))}
							</ul>
						</>
					)
				}
				<ul class="tags">
					{project.tags.map((tag) => <li>{tag}</li>)}
				</ul>
				{
					project.href && (
						<p>
							<a href={project.href} rel="noopener">{project.hrefLabel ?? "Repository"} →</a>
						</p>
					)
				}
			</article>
			<p style="margin-top: 3rem;"><a href="/projects/">← All projects</a></p>
		</div>
	</section>
</Base>
