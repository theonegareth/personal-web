---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site, projects, experience, education, skills, languages, certifications } from "../data/site";
import { openData } from "../data/opendata";
import { getCollection } from "astro:content";
import strawberryArm from "../assets/projects/strawberry-arm.jpg";
import portrait from "../assets/gareth.jpg";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const fmt = (n: number) => n.toLocaleString("en-GB");

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<Base>
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<p class="eyebrow">Robotics · Automation · Applied ML</p>
				<h1>{site.name}</h1>
				<p class="lede">
					Automotive and Robotics Engineering student at BINUS ASO, building robots that navigate, see,
					and decide. Based in {site.location}.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="/projects/">See the work</a>
					<p class="hero-links">
						<a href={site.github} rel="me noopener">GitHub</a>
						<a href={site.linkedin} rel="me noopener">LinkedIn</a>
						<a href={site.huggingface} rel="me noopener">Hugging Face</a>
						<a href={site.kaggle} rel="me noopener">Kaggle</a>
						<a href={`mailto:${site.email}`}>Email</a>
					</p>
				</div>
			</div>
			<figure class="hero-figure">
				<Image src={strawberryArm} alt="SolidWorks render of the strawberry-picking robotic arm with its slotted basket end effector" widths={[480, 720, 960]} sizes="(min-width: 56rem) 34rem, 100vw" loading="eager" />
				<figcaption>Strawberry-picking arm, SolidWorks assembly — BINUS ASO School of Engineering</figcaption>
			</figure>
		</div>
		<div class="wrap">
			<dl class="facts">
				<div>
					<dt>Studying</dt>
					<dd>B.Eng. Robotics, class of 2027</dd>
				</div>
				<div>
					<dt>Most recently</dt>
					<dd>Lab assistant, Toyohashi University of Technology</dd>
				</div>
				<div>
					<dt>Competitions</dt>
					<dd>KRTI 2024 and 2025 with AeroBASE</dd>
				</div>
				<div>
					<dt>GPA</dt>
					<dd>3.86 / 4.00</dd>
				</div>
			</dl>
		</div>
	</section>

	<section id="work">
		<div class="wrap">
			<div class="section-head">
				<h2 class="section-title">Selected work</h2>
				<a href="/projects/">All {projects.length} projects →</a>
			</div>
			<div class="work-grid">
				{
					featured.map((project) => (
						<article class="card">
							{project.image && (
								<figure>
									<Image src={project.image} alt={project.imageAlt ?? project.title} widths={[480, 720, 960]} sizes="(min-width: 48rem) 34rem, 100vw" />
								</figure>
							)}
							<div class="card-body">
								<p class="meta">{[project.org, project.period].filter(Boolean).join(" · ")}</p>
								<h3>{project.href ? <a href={project.href} rel="noopener">{project.title}</a> : project.title}</h3>
								<p>{project.blurb}</p>
								<ul class="tags">
									{project.tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
			<ol class="index-list">
				{
					rest.map((project) => (
						<li>
							<span class="period">{project.period?.split(" - ").pop() ?? "—"}</span>
							<div>
								<h3>{project.href ? <a href={project.href} rel="noopener">{project.title}</a> : project.title}</h3>
								{project.org && <p class="org">{project.org}</p>}
							</div>
							<ul class="tags">
								{project.tags.slice(0, 3).map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="experience">
		<div class="wrap">
			<div class="section-head">
				<h2 class="section-title">Experience</h2>
			</div>
			<ol class="ledger">
				{
					experience.map((job) => (
						<li>
							<p class="period">{job.period}</p>
							<div>
								<h3>{job.role}</h3>
								<p class="org">
									<strong>{job.org}</strong>
									{job.location ? ` · ${job.location}` : ""}
								</p>
								<p>{job.summary}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="about">
		<div class="wrap split">
			<div>
				<div class="section-head">
					<h2 class="section-title">About</h2>
				</div>
				<Image class="portrait" src={portrait} alt="Gareth Aurelius Harrison" widths={[240, 480]} sizes="15rem" />
				<div class="prose">
					<p>
						I work at the seam between hardware and software: ROS navigation stacks, vision models
						quantized for a Raspberry Pi, CAD for the parts that hold them together. Most of my
						projects start as a physical problem, like picking a strawberry or docking a robot, and
						end as a system that has been calibrated, tested, and made to work in the real world.
					</p>
					<p>
						Alongside engineering I have led student organisations, taught lab courses, and run
						esports tournaments for eighty-plus teams. I speak Indonesian, English, and enough
						Japanese and Mandarin to get by.
					</p>
				</div>
			</div>
			<dl class="facts-list">
				<div>
					<dt>Education</dt>
					{
						education.map((item) => (
							<dd>
								{item.degree}
								<span class="meta">
									{item.school} · {item.detail}
								</span>
							</dd>
						))
					}
				</div>
				<div>
					<dt>Languages</dt>
					{
						languages.map((item) => (
							<dd>
								{item.name} <span class="meta">{item.level}</span>
							</dd>
						))
					}
				</div>
				<div>
					<dt>Certifications</dt>
					{
						certifications.map((cert) => (
							<dd>
								{cert.name}
								<span class="meta">
									{cert.issuer} · {cert.date}
								</span>
							</dd>
						))
					}
				</div>
			</dl>
		</div>
	</section>

	<section id="skills">
		<div class="wrap">
			<div class="section-head">
				<h2 class="section-title">Skills</h2>
			</div>
			<ul class="skill-rows">
				{
					skills.map((group) => (
						<li>
							<h3>{group.group}</h3>
							<ul class="tags">
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		openData && (
			<section id="open-source">
				<div class="wrap">
					<div class="section-head">
						<h2 class="section-title">Models &amp; datasets</h2>
						<span>Published on Hugging Face and Kaggle</span>
					</div>
					<dl class="facts hf-facts">
						<div>
							<dt>Downloads, all time</dt>
							<dd>{fmt(openData.downloads)}</dd>
						</div>
						<div>
							<dt>Downloads, last 30 days</dt>
							<dd>{`${fmt(openData.downloadsRecent)} on Hugging Face`}</dd>
						</div>
						<div>
							<dt>Dataset page views</dt>
							<dd>{`${fmt(openData.views)} on Kaggle`}</dd>
						</div>
						<div>
							<dt>Likes and upvotes</dt>
							<dd>{fmt(openData.votes)}</dd>
						</div>
					</dl>
					{openData.platforms.map((platform) => (
						<div class="platform">
							<h3 class="platform-name">
								<a href={platform.url} rel="me noopener">
									{platform.name} →
								</a>
								<span>{`${fmt(platform.repos.reduce((total, repo) => total + (repo.downloads ?? 0), 0))} downloads across ${platform.repos.length} repositories`}</span>
							</h3>
							<ol class="index-list">
								{platform.repos.map((repo) => (
									<li>
										<span class="period">
											{repo.downloads === null ? "—" : `${fmt(repo.downloads)} ↓`}
										</span>
										<div>
											<h3>
												<a href={repo.url} rel="noopener">
													{repo.name}
												</a>
											</h3>
											<p class="org">
												{`${repo.kind} · updated ${repo.updated.toLocaleDateString("en-GB", { dateStyle: "medium" })}`}
											</p>
										</div>
										<ul class="tags">
											{repo.views ? <li>{fmt(repo.views)} views</li> : null}
											{repo.downloadsRecent ? <li>{fmt(repo.downloadsRecent)} in 30d</li> : null}
											{repo.votes ? <li>{repo.votes} ♥</li> : null}
										</ul>
									</li>
								))}
							</ol>
						</div>
					))}
					<p class="hf-note">
						Read from the Hugging Face and Kaggle APIs at build time on{" "}
						<time datetime={openData.fetched.toISOString()}>
							{openData.fetched.toLocaleDateString("en-GB", { dateStyle: "long" })}
						</time>
						.
					</p>
				</div>
			</section>
		)
	}

	{
		posts.length > 0 && (
			<section id="writing">
				<div class="wrap">
					<div class="section-head">
						<h2 class="section-title">Writing</h2>
						<a href="/blog/">All posts →</a>
					</div>
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<time datetime={post.data.date.toISOString()}>
									{post.data.date.toLocaleDateString("en-GB", { dateStyle: "long" })}
								</time>
								<p>{post.data.description}</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section id="contact" class="contact">
		<div class="wrap">
			<p class="eyebrow">Contact</p>
			<h2>Open to robotics, automation, and applied ML work.</h2>
			<p>Internships, research positions, and collaborations. Reply within a day or two.</p>
			<a class="email" href={`mailto:${site.email}`}>{site.email}</a>
			<p class="hero-links">
				<a href={site.github} rel="me noopener">GitHub</a>
				<a href={site.linkedin} rel="me noopener">LinkedIn</a>
				<a href={site.huggingface} rel="me noopener">Hugging Face</a>
				<a href={site.kaggle} rel="me noopener">Kaggle</a>
			</p>
		</div>
	</section>
</Base>
